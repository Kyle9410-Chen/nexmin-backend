# Copy to .env next to this file: compose reads it automatically, so every
# `docker compose` invocation in this directory -- logs, down, ps -- picks the values
# up without having to be prefixed with them.
#
#   cp .env.example .env && $EDITOR .env
#
# SECRET and BASE_URL have no defaults on purpose; compose refuses to start without
# them. Everything else falls back to a value in compose.yaml.

# Signs access tokens. Anything unguessable; changing it invalidates every issued
# token.
SECRET=

# Where this deployment is reached. Google OAuth requires the authorized redirect URI
# to be exactly {BASE_URL}/api/auth/google/callback.
BASE_URL=http://localhost:8081

# Where the OAuth callback sends the browser afterwards.
#FRONTEND_URL=http://localhost:3000

#ALLOW_ORIGINS=*
#POSTGRES_PASSWORD=password

# Override to run a locally built image instead of the published tag.
#IMAGE=nexmin-backend:test

# Google OAuth client. Login is unavailable without these.
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=

# Workspace service account, optional: without it the service still starts and the
# mailing list routes answer 503. Key is base64 of the JSON (base64 -w0 key.json).
#GOOGLE_SERVICE_ACCOUNT_KEY=
#GOOGLE_IMPERSONATE_SUBJECT=
#GOOGLE_LOGIN_GROUP=
#GOOGLE_GROUP_DOMAIN=sdc.nycu.club
#GOOGLE_GROUP_CACHE_TTL=5m

# Google Form response sheet, optional: at startup, club members with no local row get
# one created from it so the roster shows names. Needs the service account key above and
# a login group; share the sheet with the service account's own address (Viewer).
# The column letters have no defaults -- a form's layout decides them.
#GOOGLE_SHEET_ID=
#GOOGLE_SHEET_NAME=表單回應 1
#GOOGLE_SHEET_EMAIL_COLUMN=B
#GOOGLE_SHEET_NAME_COLUMN=C
#GOOGLE_SHEET_NICKNAME_COLUMN=D
#GOOGLE_SHEET_HEADER_ROWS=1
